{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist",
    ".astro",
    ".wrangler",
    ".cloudflare",
    "styled-system",
    ".claude",
    ".agents/**",
    "skills-lock.json",
    "pnpm-lock.yaml"
  ]
}
