      "Bash(cf deploy)",
      "Bash(cf deploy *)",
      "Bash(* cf deploy)",
      "Bash(* cf deploy *)",
      "Bash(cf auth *)",
      "Bash(* cf auth *)",
      "Bash(wrangler deploy *)",
      "Bash(* wrangler deploy *)",
      "Bash(* whoami*)",
      "Bash(whoami*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Read(~/.config/cloudflare/**)",
      "Read(./.env*)"
    ]
  }
}
